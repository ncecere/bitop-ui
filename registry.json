  "items": [
    {
      "name": "core",
      "type": "registry:lib",
      "title": "Core",
      "description": "Design tokens, base styles (reset, focus ring, reduced motion), the Inter font, shared popup styles and the cx/dataFlag helpers. Every component depends on it.",
      "dependencies": [
        "@fontsource-variable/inter@^5.2.0"
      ],
      "registryDependencies": [
        "@bitop/theme-neutral"
      ],
      "files": [
        {
          "path": "registry/bitop/lib/bitop-utils.ts",
          "type": "registry:lib",
          "target": "@lib/bitop-utils.ts"
        },
        {
          "path": "registry/bitop/ui/styles/bitop.css",
          "type": "registry:file",
          "target": "@ui/styles/bitop.css"
        },
        {
          "path": "registry/bitop/ui/styles/tokens.css",
          "type": "registry:file",
          "target": "@ui/styles/tokens.css"
        },
        {
          "path": "registry/bitop/ui/styles/global.css",
          "type": "registry:file",
          "target": "@ui/styles/global.css"
        },
        {
          "path": "registry/bitop/ui/styles/popup.module.css",
          "type": "registry:file",
          "target": "@ui/styles/popup.module.css"
        }
      ],
      "docs": "bitop-ui: import \"@/components/ui/styles/bitop.css\" once at your app entry (e.g. src/main.tsx), before other CSS. See the installation guide for the Vite/TypeScript requirements.",
      "categories": [
        "foundation"
      ]
    },
