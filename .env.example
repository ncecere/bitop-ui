# Absolute URL where the docs site (and therefore /r/*.json) is served.
# Used for install commands in the docs, the Vite base path, and, when set
# for `npm run registry:build`, to turn @bitop/* registryDependencies into
# absolute URLs. Example for GitHub Pages:
# SITE_URL=https://OWNER.github.io/bitop-ui
SITE_URL=
