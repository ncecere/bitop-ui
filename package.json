{
  "name": "bitop-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "A copy-and-own React component registry built on Base UI, CSS Modules and CSS variables. Installed with the shadcn CLI.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run registry:build && npm run docs:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "styling:check": "node scripts/check-styling.mjs",
    "docs:build": "vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run styling:check && npm run test && npm run build && npm run registry:validate",
    "a11y:browser": "node scripts/a11y-docs.mjs",
    "smoke:consumer": "bash scripts/consumer-smoke.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "shadcn": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vitest-axe": "0.1.0"
  }
}
